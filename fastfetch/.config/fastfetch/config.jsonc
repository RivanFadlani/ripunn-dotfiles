{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "fedora_small",
    "color": {
      "1": "white"
    },
    "padding": {
      "top": 2,
      "right": 4
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "blue",
        "at": "white",
        "host": "cyan"
      }
    },
    "break",
    {
      "type": "os",
      "key": "os      ",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "kernel  ",
      "keyColor": "light_green"
    },
    {
      "type": "wm",
      "key": "de/wm   ",
      "keyColor": "light_cyan"
    },
    {
      "type": "host",
      "key": "host    ",
      "keyColor": "blue"
    }, 
    {
      "type": "uptime",
      "key": "uptime  ",
      "keyColor": "light_yellow"
    },
    {
      "type": "packages",
      "key": "pkgs    ",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "ram     ",
      "keyColor": "light_green"
    },
    {
      "type": "disk",
      "key": "disk    ",
      "keyColor": "light_cyan"
    }, 
    "break", // Memberikan jarak 1 baris kosong agar rapi
    {
      "type": "custom",
      "format": "          \u001b[1;33m\ueefe  \u001b[1;35m\ueefe  \u001b[1;32m\ueefe  \u001b[1;36m\ueefe  \u001b[1;34m\ueefe"
    }
  ]
}
